# Variables du CLIENT UTCP qui consomme ce manuel (fichier .env lu par load_variables_from).
# Namespacées par le nom du manuel : "outlook" -> préfixe "outlook_"
# (règle python-utcp : `_` doublés, `-` remplacés par `_`, puis `_` + variable).
# Jeton DÉLÉGUÉ Microsoft Graph, valable environ 1 h, sans rafraîchissement automatique
# côté client UTCP : le renouveler par
#   python outils/obtenir_jeton.py --client-id <id-application> >> client/.env
# (ou remplacer la ligne ci-dessous par la sortie du script).
outlook_OUTLOOK_GRAPH_TOKEN=

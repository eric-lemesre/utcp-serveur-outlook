# Variables du SERVICE (à exporter avant `python -m serveur_utcp_outlook`).
# Aucun secret ici : le jeton Microsoft Graph appartient au client UTCP.
# Racine de l'API Graph rendue à la place de ${GRAPH_BASE} (défaut ci-dessous ;
# https obligatoire, http admis seulement vers loopback pour les tests).
OUTLOOK_GRAPH_BASE=https://graph.microsoft.com/v1.0
# Seulement si le manuel cite ${BASE_URL} (URL publique de ce service) :
# OUTLOOK_URL_PUBLIQUE=https://utcp.monentreprise.example
# true : les outils marqués `ecriture` sont retirés du manuel servi.
OUTLOOK_LECTURE_SEULE=false
OUTLOOK_ECOUTE_HOTE=127.0.0.1
OUTLOOK_ECOUTE_PORT=8082
OUTLOOK_JOURNAL=INFO
OUTLOOK_JOURNAL_FORMAT=texte
